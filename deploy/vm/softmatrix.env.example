# Copy to /etc/softmatrix/softmatrix.env and inject secrets through the VM secret manager.
PUBLIC_BASE_URL=https://softmatrix.example
SOFTMATRIX_DATA_DIR=/var/lib/softmatrix/data
SOFTMATRIX_OBJECT_STORE_DIR=/var/lib/softmatrix/objects
OIDC_ISSUER=https://idp.example
OIDC_CLIENT_ID=softmatrix
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Enterprise SSO
OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# Default generic mode requires email_verified=true. For Workforce Entra, use:
# OIDC_IDENTITY_MODE=entra-tenant
# OIDC_ENTRA_TENANT_ID=<workforce-tenant-guid>
OIDC_IDENTITY_MODE=verified-email
DISABLE_PASSWORD_AUTH=false
ORG_AI_MODELS=[]
ALLOW_USER_BYOK=false
ADMINS=["admin@example.com"]
